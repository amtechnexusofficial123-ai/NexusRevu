# Neon Postgres connection string (get from neon.tech project dashboard)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/reviewflow?sslmode=require

# Random long string used to sign session cookies. Generate with:
# openssl rand -base64 32
AUTH_SECRET=

# Anthropic API key, used to draft reviews from customer answers
ANTHROPIC_API_KEY=
